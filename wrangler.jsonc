// Cloudflare Workers static assets: serves dist/ only. There is no "main" entry,
// so no server code runs; headers (including the CSP) come from dist/_headers.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bip39-ai",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "bip39.ai", "custom_domain": true }],
  // Served only on bip39.ai; www.bip39.ai is redirected by redirect-www/.
  "workers_dev": false,
  "preview_urls": false
}
