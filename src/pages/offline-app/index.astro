---
// Source for the standalone offline file. scripts/build-offline.mjs bundles this
// page into dist/downloads/<file> and then removes it from the public site.
import '../../styles/global.css';
import ModeBadge from '../../components/ModeBadge.astro';
import Notice from '../../components/Notice.astro';
import ToolGenerator from '../../components/ToolGenerator.astro';
import ToolValidator from '../../components/ToolValidator.astro';
import ToolConverter from '../../components/ToolConverter.astro';
import ToolChecksum from '../../components/ToolChecksum.astro';
import ToolWordList from '../../components/ToolWordList.astro';
import { SITE } from '../../site';
const TABS = [
  { id: 'generator', label: 'Generator' },
  { id: 'validator', label: 'Validator' },
  { id: 'converter', label: 'Converter' },
  { id: 'checksum', label: 'Checksum' },
  { id: 'wordlist', label: 'Word List' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content="__OFFLINE_CSP__" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>BIP39.ai Offline v{SITE.version}</title>
  </head>
  <body class="is-offline" data-offline-app>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <span class="brand">
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="var(--accent)"/><g fill="var(--accent-contrast)"><rect x="7" y="8" width="4" height="4" rx="1"/><rect x="14" y="8" width="4" height="4" rx="1"/><rect x="21" y="8" width="4" height="4" rx="1"/><rect x="7" y="14" width="4" height="4" rx="1"/><rect x="14" y="14" width="4" height="4" rx="1"/><rect x="21" y="14" width="4" height="4" rx="1" fill="var(--bits-cs)"/><rect x="7" y="20" width="18" height="4" rx="1" opacity=".55"/></g></svg>
          BIP39.ai
        </span>
        <div class="header-tools">
          <ModeBadge offline version={SITE.version} />
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch color theme">
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </div>
    </header>
    <div id="live" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
    <main id="main" tabindex="-1" class="container">
      <div class="page-head u-pt40 with-top">
        <h1>BIP39 Offline Tools</h1>
        <p class="lede">Version {SITE.version}. Everything runs inside this file; network connections are blocked by its Content Security Policy.</p>
      </div>
      <div data-env-online hidden><Notice kind="warning">This device appears to be <strong>online</strong>. Disconnect from the network before entering a real recovery phrase.</Notice></div>
      <div data-env-http hidden><Notice kind="warning">This file is being served from a website, not opened locally. Download it and open the local copy instead.</Notice></div>
      <fieldset class="seg full">
        <legend class="label">Tool</legend>
        <div class="seg-options">
          {TABS.map((t, i) => <label><input type="radio" name="offline-tab" value={t.id} checked={i === 0} aria-controls={`tab-${t.id}`} /><span>{t.label}</span></label>)}
        </div>
      </fieldset>
      <section id="tab-generator" data-tab="generator"><ToolGenerator /></section>
      <section id="tab-validator" data-tab="validator" hidden><ToolValidator /></section>
      <section id="tab-converter" data-tab="converter" hidden><ToolConverter headingLevel="h3" /></section>
      <section id="tab-checksum" data-tab="checksum" hidden><ToolChecksum /></section>
      <section id="tab-wordlist" data-tab="wordlist" hidden><ToolWordList downloads={false} /></section>
      <p class="small muted u-mt20">BIP39.ai offline {SITE.version}{SITE.commit ? ` · commit ${SITE.commit}` : ''} · {SITE.license} License · Specification: bitcoin/bips BIP-0039. Verify this file against the SHA-256 published at https://bip39.ai/bip39-offline/</p>
    </main>
    <script>import '../../scripts/offline-app';</script>
  </body>
</html>
