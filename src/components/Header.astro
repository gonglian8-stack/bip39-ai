---
import { LEARN, SITE, TOOLS, PAGES } from '../site';
import Icon from './Icon.astro';
import ModeBadge from './ModeBadge.astro';
interface Props { path: string }
const { path } = Astro.props;
const cur = (href: string) => (path === href ? 'page' : undefined);
const repo = SITE.repoUrl ?? PAGES.openSource.href;
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="BIP39.ai home">
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="var(--accent)"/><g fill="var(--accent-contrast)"><rect x="7" y="8" width="4" height="4" rx="1"/><rect x="14" y="8" width="4" height="4" rx="1"/><rect x="21" y="8" width="4" height="4" rx="1"/><rect x="7" y="14" width="4" height="4" rx="1"/><rect x="14" y="14" width="4" height="4" rx="1"/><rect x="21" y="14" width="4" height="4" rx="1" fill="var(--bits-cs)"/><rect x="7" y="20" width="18" height="4" rx="1" opacity=".55"/></g></svg>
      BIP39.ai
    </a>
    <nav class="nav" aria-label="Main">
      <details data-popover>
        <summary>Tools <Icon name="chevron" class="chev" /></summary>
        <div class="menu-panel">
          {TOOLS.map((t) => <a href={t.href} aria-current={cur(t.href)}><strong>{t.title}</strong><span>{t.desc}</span></a>)}
        </div>
      </details>
      <a href={PAGES.wordlist.href} aria-current={cur(PAGES.wordlist.href)}>Word List</a>
      <details data-popover>
        <summary>Learn <Icon name="chevron" class="chev" /></summary>
        <div class="menu-panel">
          {LEARN.map((t) => <a href={t.href} aria-current={cur(t.href)}><strong>{t.title}</strong><span>{t.desc}</span></a>)}
        </div>
      </details>
      <a href={PAGES.offline.href} aria-current={cur(PAGES.offline.href)}>Offline</a>
    </nav>
    <div class="header-tools">
      <ModeBadge />
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">
        <Icon name="moon" class="i-moon" /><Icon name="sun" class="i-sun" />
      </button>
      <a class="icon-btn gh-link" href={repo} aria-label={SITE.repoUrl ? 'Source code on GitHub' : 'Open source status'} title="Source code"><Icon name="github" /></a>
      <details class="mobile-nav" data-popover>
        <summary class="icon-btn" aria-label="Menu"><Icon name="menu" /></summary>
        <nav class="drawer" aria-label="Main">
          <h2>Tools</h2>
          {TOOLS.map((t) => <a href={t.href} aria-current={cur(t.href)}>{t.title}</a>)}
          <a href={PAGES.wordlist.href} aria-current={cur(PAGES.wordlist.href)}>Word List</a>
          <h2>Learn</h2>
          {LEARN.filter((t) => !t.href.includes('#')).map((t) => <a href={t.href} aria-current={cur(t.href)}>{t.title}</a>)}
          <h2>Offline &amp; trust</h2>
          <a href={PAGES.offline.href}>Offline download</a>
          <a href={PAGES.security.href}>Security model</a>
          <a href={PAGES.privacy.href}>Privacy</a>
          <a href={PAGES.openSource.href}>Open source</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>import '../scripts/header';</script>
