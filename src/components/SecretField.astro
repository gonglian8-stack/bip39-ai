---
// Container for any input that could receive a mnemonic, entropy or passphrase.
// Inputs are never inside a <form>, so nothing can be submitted into a URL.
import { PAGES } from '../site';
interface Props {
  id: string;
  label: string;
  multiline?: boolean;
  rows?: number;
  placeholder?: string;
  password?: boolean;
  note?: boolean;
  describedBy?: string;
}
const { id, label, multiline = false, rows = 3, placeholder, password = false, note = true, describedBy } = Astro.props;
const noteId = `${id}-note`;
const errId = `${id}-error`;
const desc = [note ? noteId : null, describedBy, errId].filter(Boolean).join(' ');
const common = {
  id, class: 'field', autocomplete: 'off', autocapitalize: 'off', autocorrect: 'off',
  spellcheck: 'false', 'data-sensitive': '', 'aria-describedby': desc, placeholder,
};
---
<div class="secret-field">
  <div class="sf-head">
    <label for={id}>{label}</label>
    <span class="tag secret">Sensitive input</span>
  </div>
  {note && <p class="sf-note" id={noteId}><span class="online-only">Use test data only. For a real recovery phrase, use the <a href={PAGES.offline.href}>offline tool</a>.</span><span class="offline-only">Keep this device disconnected while entering a real phrase. Close the browser when done.</span></p>}
  {multiline
    ? <textarea {...common} rows={rows}></textarea>
    : <input {...common} type={password ? 'password' : 'text'} data-lpignore="true" data-1p-ignore="" />}
  <p class="field-error" id={errId} role="alert" hidden></p>
  <div class="sf-foot"><slot /></div>
</div>
